// Video 348 — How I Redesigned a Database With 2,241 Tables
// The new design: 3 tables replace the 2,241 client_ tables.

Project video_348 {
  database_type: 'PostgreSQL'
  Note: 'Redesign of the "DB with 2241 tables" database from r/programminghorror'
}

Table client {
  client_id int [pk, increment, note: 'GENERATED BY DEFAULT AS IDENTITY, keeps the old table ID']
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  date_of_birth date [not null, note: 'Replaces days_since_birth. Age is calculated with AGE()']
  sex varchar(20)
  email varchar(255) [unique]
  phone varchar(30)
  notes text [note: 'From the assumed second column on some old tables']
  created_at timestamp [not null, default: `now()`]

  indexes {
    last_name [name: 'ix_client_last_name']
    date_of_birth [name: 'ix_client_date_of_birth']
  }
}

Table study {
  study_id int [pk, increment]
  study_code varchar(20) [not null, unique]
  study_name varchar(200) [not null]
}

Table enrolment {
  client_id int [not null]
  study_id int [not null]
  enrolled_date date [not null]
  status varchar(20) [not null]

  indexes {
    (client_id, study_id) [pk]
    study_id [name: 'ix_enrolment_study']
  }
}

Ref: enrolment.client_id > client.client_id [delete: cascade]
Ref: enrolment.study_id > study.study_id
