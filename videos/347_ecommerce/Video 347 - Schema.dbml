// Video 347 — eCommerce Database Design
// Complete schema. Paste into dbdiagram.io
// Demo SQL in the script is written for PostgreSQL.

Project ecommerce {
  database_type: 'PostgreSQL'
  Note: '''
  eCommerce database design for Database Star Video 347.

  Constraints not shown on the diagram (create them in SQL):
  - One default address per customer:
    CREATE UNIQUE INDEX uq_address_default ON address (customer_id) WHERE is_default = true;
  - One default payment method per customer:
    CREATE UNIQUE INDEX uq_payment_method_default ON payment_method (customer_id) WHERE is_default = true;
  - One cart per customer (order_status_id 1 = Cart):
    CREATE UNIQUE INDEX uq_one_cart_per_customer ON customer_order (customer_id) WHERE order_status_id = 1;
  - Review rating between 1 and 5:
    ALTER TABLE review ADD CONSTRAINT ck_review_rating CHECK (rating BETWEEN 1 AND 5);
  '''
}

// ------------------------------------------------------------
// Customers
// ------------------------------------------------------------

Table customer {
  customer_id int [pk, increment]
  email varchar(255) [not null, unique, note: 'Used to log in']
  password_hash varchar(255) [not null, note: 'Hashed by the application, never plain text']
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  phone varchar(30) [null]
  created_at timestamp [not null]
}

Table country {
  country_id int [pk, increment]
  country_name varchar(100) [not null, unique]
}

Table address {
  address_id int [pk, increment]
  customer_id int [not null, ref: > customer.customer_id]
  address_line1 varchar(255) [not null]
  address_line2 varchar(255) [null]
  city varchar(100) [not null]
  region varchar(100) [null]
  postal_code varchar(20) [null]
  country_id int [not null, ref: > country.country_id]
  is_default boolean [not null, default: false, note: 'One default per customer (partial unique index)']
}

Table payment_type {
  payment_type_id int [pk, increment]
  type_name varchar(50) [not null, unique, note: 'Card, PayPal, etc.']
}

Table payment_method {
  payment_method_id int [pk, increment]
  customer_id int [not null, ref: > customer.customer_id]
  payment_type_id int [not null, ref: > payment_type.payment_type_id]
  provider varchar(50) [not null, note: 'e.g. Stripe']
  provider_token varchar(255) [not null, note: 'Token from the payment provider. Card numbers are never stored']
  card_brand varchar(30) [null]
  last_four char(4) [null]
  expiry_month int [null]
  expiry_year int [null]
  is_default boolean [not null, default: false, note: 'One default per customer (partial unique index)']
}

// ------------------------------------------------------------
// Products
// ------------------------------------------------------------

Table category {
  category_id int [pk, increment]
  category_name varchar(100) [not null]
  parent_category_id int [null, ref: > category.category_id, note: 'NULL = top-level category']
}

Table product {
  product_id int [pk, increment]
  product_name varchar(255) [not null]
  description text [null]
  brand varchar(100) [null]
  created_at timestamp [not null]
}

Table product_category {
  product_id int [not null, ref: > product.product_id]
  category_id int [not null, ref: > category.category_id]

  indexes {
    (product_id, category_id) [pk]
  }
}

Table product_variant {
  variant_id int [pk, increment]
  product_id int [not null, ref: > product.product_id]
  sku varchar(50) [not null, unique]
  price decimal(10,2) [not null]
  qty_in_stock int [not null, default: 0]
}

Table product_option {
  option_id int [pk, increment]
  product_id int [not null, ref: > product.product_id]
  option_name varchar(50) [not null, note: 'e.g. Size, Colour']

  indexes {
    (product_id, option_name) [unique]
  }
}

Table product_option_value {
  option_value_id int [pk, increment]
  option_id int [not null, ref: > product_option.option_id]
  value_name varchar(50) [not null, note: 'e.g. S, M, L, Black']

  indexes {
    (option_id, value_name) [unique]
    (option_value_id, option_id) [unique, note: 'Target for the composite foreign key']
  }
}

Table variant_option_value {
  variant_id int [not null, ref: > product_variant.variant_id]
  option_id int [not null]
  option_value_id int [not null]

  indexes {
    (variant_id, option_id) [pk, note: 'One value per option for each variant']
  }
}

// The value must belong to the option
Ref: variant_option_value.(option_value_id, option_id) > product_option_value.(option_value_id, option_id)

Table product_image {
  image_id int [pk, increment]
  product_id int [not null, ref: > product.product_id]
  variant_id int [null, ref: > product_variant.variant_id, note: 'NULL = applies to all variants']
  image_url varchar(500) [not null]
  sort_order int [not null, default: 1]
}

// ------------------------------------------------------------
// Orders
// ------------------------------------------------------------

Table order_status {
  order_status_id int [pk, increment]
  status_name varchar(30) [not null, unique, note: 'Cart, Placed, Paid, Shipped, Delivered, Cancelled']
}

Table shipping_method {
  shipping_method_id int [pk, increment]
  method_name varchar(50) [not null, unique, note: 'Standard, Express, etc.']
  price decimal(10,2) [not null]
}

Table customer_order {
  order_id int [pk, increment]
  customer_id int [not null, ref: > customer.customer_id]
  order_status_id int [not null, ref: > order_status.order_status_id, note: 'Status 1 (Cart) = order not yet placed']
  order_date timestamp [null, note: 'NULL while the order is a cart']
  shipping_method_id int [null, ref: > shipping_method.shipping_method_id]
  shipping_cost decimal(10,2) [null, note: 'Copied at checkout']
  ship_name varchar(200) [null, note: 'Shipping address fields are copied at checkout']
  ship_address_line1 varchar(255) [null]
  ship_address_line2 varchar(255) [null]
  ship_city varchar(100) [null]
  ship_region varchar(100) [null]
  ship_postal_code varchar(20) [null]
  ship_country varchar(100) [null]
  subtotal decimal(10,2) [null]
  discount_total decimal(10,2) [null]
  order_total decimal(10,2) [null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table order_line {
  order_line_id int [pk, increment]
  order_id int [not null, ref: > customer_order.order_id]
  variant_id int [not null, ref: > product_variant.variant_id]
  quantity int [not null]
  product_name varchar(255) [null, note: 'Copied at checkout']
  sku varchar(50) [null, note: 'Copied at checkout']
  option_summary varchar(255) [null, note: 'e.g. Black / M, copied at checkout']
  unit_price decimal(10,2) [null, note: 'Copied at checkout']
  discount_amount decimal(10,2) [null, note: 'Promotion discount applied at checkout']

  indexes {
    (order_id, variant_id) [unique]
  }
}

Table payment {
  payment_id int [pk, increment]
  order_id int [not null, ref: > customer_order.order_id]
  payment_method_id int [null, ref: > payment_method.payment_method_id]
  provider_reference varchar(255) [not null, note: 'Transaction ID from the payment provider']
  amount decimal(10,2) [not null]
  payment_status varchar(30) [not null, note: 'e.g. Succeeded, Failed, Refunded']
  created_at timestamp [not null]
}

// ------------------------------------------------------------
// Promotions and reviews
// ------------------------------------------------------------

Table promotion {
  promotion_id int [pk, increment]
  promotion_name varchar(100) [not null]
  description text [null]
  discount_type varchar(20) [not null, note: 'Percentage or Fixed']
  discount_value decimal(10,2) [not null]
  start_date timestamp [not null]
  end_date timestamp [not null]
}

Table promotion_product {
  promotion_id int [not null, ref: > promotion.promotion_id]
  product_id int [not null, ref: > product.product_id]

  indexes {
    (promotion_id, product_id) [pk]
  }
}

Table review {
  review_id int [pk, increment]
  order_line_id int [not null, unique, ref: > order_line.order_line_id, note: 'Only purchased items can be reviewed, one review per purchase']
  rating int [not null, note: 'CHECK (rating BETWEEN 1 AND 5)']
  comment text [null]
  created_at timestamp [not null]
}

// ------------------------------------------------------------
// Table groups (shown as coloured areas on the diagram)
// ------------------------------------------------------------

TableGroup customers {
  customer
  country
  address
  payment_type
  payment_method
}

TableGroup products {
  category
  product
  product_category
  product_variant
  product_option
  product_option_value
  variant_option_value
  product_image
}

TableGroup orders {
  order_status
  shipping_method
  customer_order
  order_line
  payment
}

TableGroup promotions_and_reviews {
  promotion
  promotion_product
  review
}
